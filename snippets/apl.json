{
  "function-definition": {
    "scope": "apl",
    "prefix": "function",
    "body": [
      "function ${1:name}(${2:})${3: -> ${4:i32}} {",
      "\t${0:return 0;}",
      "}"
    ],
    "description": "Function definition (return type optional)"
  },
  "function-prototype": {
    "scope": "apl",
    "prefix": "fproto",
    "body": [
      "function ${1:name}(${2:})${3: -> ${4:i32}};"
    ],
    "description": "Function prototype (return type optional)"
  },
  "function-signature-variable": {
    "scope": "apl",
    "prefix": "fnsig",
    "body": [
      "ptr fn(${1:i32, i32})${2:i32} ${3:name};"
    ],
    "description": "Function signature variable"
  },
  "container-definition": {
    "scope": "apl",
    "prefix": "container",
    "body": [
      "container ${1:name} {",
      "\t${2:u32 field = 0;}",
      "",
      "\tfunction ${3:method}(self) -> i0 {",
      "\t\t${0}",
      "\t}",
      "}"
    ],
    "description": "Struct-like container with fields and methods"
  },
  "container-implements-interface": {
    "scope": "apl",
    "prefix": "cimpl",
    "body": [
      "container ${1:name} implements ${2:interface} {",
      "\t${3:u32 field = 0;}",
      "",
      "\t@[override]",
      "\tfunction ${4:method}(ptr ${1:name} self)${5: -> ${6:i0}};",
      "}"
    ],
    "description": "Container implementing an interface"
  },
  "container-method": {
    "scope": "apl",
    "prefix": "cmethod",
    "body": [
      "function ${1:name}(self${2})${3: -> ${4:i0}} {",
      "\t${0}",
      "}"
    ],
    "description": "Container method with self parameter"
  },
  "interface-definition": {
    "scope": "apl",
    "prefix": "interface",
    "body": [
      "interface ${1:name}${2: implements ${3:base}} {",
      "\t@[self] @[abstract]",
      "\tfunction ${4:method}(ptr ${1:name} self)${5: -> ${6:i0}};",
      "}"
    ],
    "description": "Interface method contract"
  },
  "container-field-access": {
    "scope": "apl",
    "prefix": "field",
    "body": "${1:self}.${0:field}",
    "description": "Container field access"
  },
  "APL Keywords Container": {
    "scope": "apl",
    "prefix": "container",
    "body": "container",
    "description": "APL keyword"
  },
  "APL Keywords Interface": {
    "scope": "apl",
    "prefix": "interface",
    "body": "interface",
    "description": "APL keyword"
  },
  "APL Keywords Implements": {
    "scope": "apl",
    "prefix": "implements",
    "body": "implements",
    "description": "APL keyword"
  },
  "import-op": {
    "scope": "apl",
    "prefix": "from",
    "body": [
      "from \"${1:module}\" import ${0:name}"
    ],
    "description": "Import statement"
  },
  "extern-function": {
    "scope": "apl",
    "prefix": "externfn",
    "body": [
      "extern function ${1:name}(${2:})${3: -> ${4:i32}};"
    ],
    "description": "Extern function prototype"
  },
  "extern-var": {
    "scope": "apl",
    "prefix": "externvar",
    "body": [
      "extern ${1:i32} ${0:name}"
    ],
    "description": "Extern variable prototype"
  },
  "section-block": {
    "scope": "apl",
    "prefix": "section",
    "body": [
      "section(\"${1:.text}\") {",
      "\t${0}",
      "}"
    ],
    "description": "Top-level section block"
  },
  "align-declaration": {
    "scope": "apl",
    "prefix": "align",
    "body": [
      "align(${1:16}) ${2:i32 ${3:name}${4: = ${5:0}};}"
    ],
    "description": "Aligned declaration"
  },
  "align-block": {
    "scope": "apl",
    "prefix": "alignblock",
    "body": [
      "align(${1:16}) {",
      "\t${0:i32 x = 0;}",
      "}"
    ],
    "description": "Aligned declaration block"
  },
  "poparg-assignment": {
    "scope": "apl",
    "prefix": "popargvar",
    "body": [
      "${1:i32} ${2:name} = poparg;"
    ],
    "description": "Assign poparg to local variable"
  },
  "APL Ops POPARG": {
    "scope": "apl",
    "prefix": "poparg",
    "body": "poparg",
    "description": "APL poparg expression"
  },
  "APL Ops NEG": {
    "scope": "apl",
    "prefix": "neg",
    "body": "neg ${1:x}",
    "description": "APL bitwise inversion expression"
  },
  "APL Ops SIZEOF": {
    "scope": "apl",
    "prefix": "sizeof",
    "body": [
      "sizeof(${1:i32})"
    ],
    "description": "APL sizeof expression"
  },
  "APL Ops PLACE": {
    "scope": "apl",
    "prefix": "place",
    "body": [
      "place(${1:address}, ${2:container})"
    ],
    "description": "Construct a container instance in existing storage"
  },
  "APL Types void": {
    "scope": "apl",
    "prefix": "i0",
    "body": "i0",
    "description": "APL i0 type"
  },
  "defer-call": {
    "scope": "apl",
    "prefix": "defer",
    "body": "defer ${1:cleanup}(${0});",
    "description": "Deferred function call"
  },

  "APL Keywords Section": {
    "scope": "apl",
    "prefix": "section",
    "body": "section",
    "description": "APL keyword"
  },
  "APL Keywords Align": {
    "scope": "apl",
    "prefix": "align",
    "body": "align",
    "description": "APL keyword"
  },
  "annotation-generic": {
    "scope": "apl",
    "prefix": "ann",
    "body": [
      "@[$1]"
    ],
    "description": "Generic annotation"
  },
  "annotation-generic-arg": {
    "scope": "apl",
    "prefix": "annarg",
    "body": [
      "@[$1($2)]"
    ],
    "description": "Generic annotation with arguments"
  },
  "annotation-entry": {
    "scope": "apl",
    "prefix": "entryann",
    "body": [
      "@[entry]"
    ],
    "description": "Entry point annotation"
  },
  "annotation-naked": {
    "scope": "apl",
    "prefix": "nakedann",
    "body": [
      "@[naked]"
    ],
    "description": "Naked function annotation"
  },
  "annotation-align": {
    "scope": "apl",
    "prefix": "alignann",
    "body": [
      "@[align(${1:16})]"
    ],
    "description": "Align annotation"
  },
  "annotation-section": {
    "scope": "apl",
    "prefix": "sectionann",
    "body": [
      "@[section(\"${1:.text}\")]"
    ],
    "description": "Section annotation"
  },
  "annotation-address": {
    "scope": "apl",
    "prefix": "addressann",
    "body": [
      "@[address(${1:0x1000})]"
    ],
    "description": "Address annotation"
  },
  "annotation-counter": {
    "scope": "apl",
    "prefix": "counterann",
    "body": [
      "@[counter(${1:10})]"
    ],
    "description": "Loop counter annotation"
  },
  "annotation-no-fall": {
    "scope": "apl",
    "prefix": "nofallann",
    "body": [
      "@[no_fall]"
    ],
    "description": "Switch no-fallthrough annotation"
  },
  "annotation-straight": {
    "scope": "apl",
    "prefix": "straightann",
    "body": [
      "@[straight]"
    ],
    "description": "Switch linear-search annotation"
  },
  "annotation-hot": {
    "scope": "apl",
    "prefix": "hotann",
    "body": [
      "@[hot]"
    ],
    "description": "Hot branch annotation"
  },
  "annotation-cold": {
    "scope": "apl",
    "prefix": "coldann",
    "body": [
      "@[cold]"
    ],
    "description": "Cold branch annotation"
  },
  "annotation-register": {
    "scope": "apl",
    "prefix": "regann",
    "body": [
      "@[register(${1:10})]"
    ],
    "description": "Register bindings for variables annotation"
  },
  "annotation-abstract": {
    "scope": "apl",
    "prefix": "abstractann",
    "body": [
      "@[abstract]"
    ],
    "description": "Abstract method contract annotation"
  },
  "annotation-override": {
    "scope": "apl",
    "prefix": "overrideann",
    "body": [
      "@[override]"
    ],
    "description": "Inherited interface method implementation annotation"
  },
  "annotation-vtable": {
    "scope": "apl",
    "prefix": "vtableann",
    "body": [
      "@[vtable]"
    ],
    "description": "Enable vtable storage for a container"
  },
  "annotation-stack": {
    "scope": "apl",
    "prefix": "annstack",
    "body": [
      "@[$1]",
      "@[$2]"
    ],
    "description": "Two stacked annotations"
  },
  "generic-associated-method-definition": {
    "scope": "apl",
    "prefix": "gfunction",
    "body": [
      "function ${1:container}::${2:name}<${3:T}>(${3:T} ${4:a})${5: -> ${3:T}} {",
      "\t${0:return ${4:a};}",
      "}"
    ],
    "description": "Generic associated method definition"
  },
  "generic-function-call": {
    "scope": "apl",
    "prefix": "gcall",
    "body": "${1:container}::${2:function}<${3:i32}>(${0})",
    "description": "Generic associated method call"
  },
  "associated-method-definition": {
    "scope": "apl",
    "prefix": "assocfn",
    "body": [
      "function ${1:node}::${2:new}(${3:})${4: -> ${1:node}} {",
      "\t${0}",
      "}"
    ],
    "description": "Associated/static method definition using Type::method"
  },
  "associated-method-prototype": {
    "scope": "apl",
    "prefix": "assocproto",
    "body": [
      "function ${1:node}::${2:new}(${3:})${4: -> ${1:node}};"
    ],
    "description": "Associated/static method prototype using Type::method"
  },
  "associated-method-call": {
    "scope": "apl",
    "prefix": "assoccall",
    "body": "${1:node}::${2:new}(${0})",
    "description": "Associated/static method call using Type::method()"
  }
}
